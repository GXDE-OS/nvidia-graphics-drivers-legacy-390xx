 #if !NV_CAN_CALL_VMA_START_WRITE
+#if !defined(NV_VMA_START_WRITE_NEW_API_PRESENT)
 static NvBool nv_vma_enter_locked(struct vm_area_struct *vma, NvBool detaching)
 {
     NvU32 tgt_refcnt = VMA_LOCK_OFFSET;
@@ -651,4 +652,27 @@
     }
 }
 EXPORT_SYMBOL(nv_vma_start_write);
+#else // NV_VMA_START_WRITE_NEW_API_PRESENT
+
+/*
+ * The per-VMA lock implementation was reworked: VMA_LOCK_OFFSET was
+ * replaced by VM_REFCNT_EXCLUDE_READERS_FLAG and __is_vma_write_locked()
+ * takes a single argument. __vma_start_write() cannot be called here
+ * because it is exported as GPL-only.
+ *
+ * nv_vm_flags_set()/nv_vm_flags_clear() are only used from mmap()
+ * callbacks, where the VMA has just been created and cannot have any
+ * readers yet. Marking the VMA as write-locked by storing the current
+ * mmap lock sequence is therefore sufficient; mmap_write_unlock() calls
+ * vma_end_write_all(), which invalidates the sequence again.
+ */
+void nv_vma_start_write(struct vm_area_struct *vma)
+{
+    if (__is_vma_write_locked(vma))
+        return;
+
+    WRITE_ONCE(vma->vm_lock_seq, __vma_raw_mm_seqnum(vma));
+}
+EXPORT_SYMBOL(nv_vma_start_write);
+#endif // NV_VMA_START_WRITE_NEW_API_PRESENT
 #endif // !NV_CAN_CALL_VMA_START_WRITE
