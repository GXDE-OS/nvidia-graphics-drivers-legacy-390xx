+            unsigned int conftest_vma_start_write_new_api(struct vm_area_struct *vma) {
+                if (__is_vma_write_locked(vma))
+                    return 0;
+                return __vma_raw_mm_seqnum(vma) +
+                       offsetof(struct vm_area_struct, vm_lock_seq);
+            }"
